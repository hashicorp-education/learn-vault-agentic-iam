# Helper image that runs mkcert to produce the Vault TLS material.
# The container for this image exits after completion by design.

FROM alpine:3.20

ARG MKCERT_VERSION=v1.4.4

RUN apk add --no-cache ca-certificates curl \
    && ARCH="$(uname -m)" \
    && case "$ARCH" in \
         x86_64)  MARCH=amd64 ;; \
         aarch64) MARCH=arm64 ;; \
         *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /usr/local/bin/mkcert \
         "https://github.com/FiloSottile/mkcert/releases/download/${MKCERT_VERSION}/mkcert-${MKCERT_VERSION}-linux-${MARCH}" \
    && chmod +x /usr/local/bin/mkcert

COPY gen-certs.sh /usr/local/bin/gen-certs.sh
RUN chmod +x /usr/local/bin/gen-certs.sh

ENTRYPOINT ["/usr/local/bin/gen-certs.sh"]
